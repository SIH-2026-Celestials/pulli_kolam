# Copy this file to .env and fill in real values for your environment.
# Never commit .env or real secrets to source control.

# --- Identity/session database (api/auth/) ---
# Unset/empty = local SQLite file (./pulli_auth.db), zero setup required.
# In production, point this at PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg2://pulli:PASSWORD@localhost:5432/pulli
# (install psycopg2-binary if using PostgreSQL -- not installed by default,
# see requirements.txt)
DATABASE_URL=

# --- Session cookie signing ---
# HMAC key used to sign the session cookie value (api/auth/security.py).
# REQUIRED whenever COOKIE_SECURE=true (the app refuses to start signing
# sessions with a hardcoded fallback secret once you've indicated this is
# a production-like deployment). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# --- Cookie behavior ---
# Set to "true" in production (requires HTTPS -- browsers drop Secure
# cookies over plain HTTP). Leave unset/false for local http://localhost dev.
COOKIE_SECURE=false

# Only needed if the API and frontend share a parent domain in production
# (e.g. api.pulli.example and app.pulli.example both under .pulli.example).
# Leave unset for local development and for single-domain deployments.
COOKIE_DOMAIN=

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API with
# credentials (cookies), e.g.:
#   CORS_ORIGINS=https://app.pulli.example,https://pulli.example
# Leave unset for local dev -- api/main.py falls back to a permissive
# localhost-only regex so the Vite dev server (any port) works out of the box.
CORS_ORIGINS=

# --- ML detector environment quirk (unrelated to auth) ---
# Already required by api/main.py itself (set at import time) -- listed
# here only for visibility, do not need to set manually.
# KMP_DUPLICATE_LIB_OK=TRUE

# --- Frontend build-time config (frontend/frontend/.env, VITE_ prefix required) ---
# Contact address shown on /contact and referenced from /privacy and
# /terms. If unset, the Contact page says so explicitly rather than
# inventing an address (see frontend/frontend/src/pages/Contact/Contact.jsx).
VITE_CONTACT_EMAIL=
