# Copy this file to .env and fill in real values for your environment.
# Never commit .env or real secrets to source control.

# ---------------------------------------------------------------------
# Frontend (frontend/frontend/) -- BUILD-TIME configuration
# ---------------------------------------------------------------------
# Read by Vite at BUILD time (frontend/frontend/src/lib/api/client.js),
# not at runtime in the browser. Changing this after `npm run build`
# has no effect -- you must rebuild. Points the deployed static
# frontend at the FastAPI backend it should call.
VITE_API_BASE_URL=http://localhost:8000

# Contact address shown on /contact and referenced from /privacy and
# /terms. If unset, the Contact page says so explicitly rather than
# inventing an address (see frontend/frontend/src/pages/Contact/Contact.jsx).
VITE_CONTACT_EMAIL=

# ---------------------------------------------------------------------
# Backend (api/main.py) -- RUNTIME configuration
# ---------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call this API with
# credentials (cookie
s), e.g.:
#   CORS_ORIGINS=https://app.pulli.example,https://pulli.example
# Leave unset for local dev -- api/main.py falls back to a permissive
# localhost-only regex so the Vite dev server (any port) works out of
# the box. Any real deployment MUST set this explicitly. Never use "*".
CORS_ORIGINS=

# --- Identity/session database (api/auth/) ---
# Unset/empty = local SQLite file (./pulli_auth.db), zero setup required.
# In production, point this at PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg2://pulli:PASSWORD@localhost:5432/pulli
# (install psycopg2-binary if using PostgreSQL -- not installed by default,
# see requirements.txt)
DATABASE_URL=

# --- Session cookie signing ---
# HMAC key used to sign the session cookie value (api/auth/security.py).
# REQUIRED whenever COOKIE_SECURE=true (the app refuses to start signing
# sessions with a hardcoded fallback secret once you've indicated this is
# a production-like deployment). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# --- Cookie behavior ---
# Set to "true" in production (requires HTTPS -- browsers drop Secure
# cookies over plain HTTP). Leave unset/false for local http://localhost dev.
COOKIE_SECURE=false

# Only needed if the API and frontend share a parent domain in production
# (e.g. api.pulli.example and app.pulli.example both under .pulli.example).
# Leave unset for local development and for single-domain deployments.
COOKIE_DOMAIN=

# --- DB pooling ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
# AUTH_DB_POOL_SIZE=3
# AUTH_DB_MAX_OVERFLOW=5

# --- Cloudflare R2 / S3 Object Storage ---
# STORAGE_PROVIDER="local" (use "r2" in production)
STORAGE_PROVIDER=local
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# --- ML detector environment quirk (unrelated to auth) ---
# KMP_DUPLICATE_LIB_OK is set inside api/main.py at import time (before
# any torch/numpy import) to work around a known PyTorch/MKL OpenMP DLL
# conflict when both libraries load in the same process. It is not an
# application secret or a knob meant for operators to tune -- it is
# listed here only so its presence in the codebase isn't a surprise.
# See api/main.py's module docstring and docs/M4_2_MODEL.md.
# KMP_DUPLICATE_LIB_OK=TRUE

