# PULLI environment variable template.
#
# There are no secrets in this project: no API keys, no database
# credentials, no third-party service tokens. Copy this file to a
# local .env (or set these as platform environment variables) and
# adjust as needed -- do not commit a real .env.

# ---------------------------------------------------------------------
# Frontend (frontend/frontend/) -- BUILD-TIME configuration
# ---------------------------------------------------------------------
# Read by Vite at BUILD time (frontend/frontend/src/lib/api/client.js),
# not at runtime in the browser. Changing this after `npm run build`
# has no effect -- you must rebuild. Points the deployed static
# frontend at the FastAPI backend it should call.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Backend (api/main.py) -- RUNTIME configuration
# ---------------------------------------------------------------------
# Comma-separated list of origins the API will accept browser requests
# from (CORS). If unset, api/main.py falls back to common local Vite
# dev-server origins (localhost:5173, localhost:3000) so local
# development works with no setup -- but that fallback does NOT cover
# a real deployment. Any deployed environment where the API is
# reachable from a browser MUST set this explicitly to the frontend's
# actual origin(s). Never use "*" here.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Internally managed -- do NOT set this yourself
# ---------------------------------------------------------------------
# KMP_DUPLICATE_LIB_OK is set inside api/main.py at import time (before
# any torch/numpy import) to work around a known PyTorch/MKL OpenMP DLL
# conflict when both libraries load in the same process. It is not an
# application secret or a knob meant for operators to tune -- it is
# listed here only so its presence in the codebase isn't a surprise.
# See api/main.py's module docstring and docs/M4_2_MODEL.md.
