# Python
__pycache__/
*.pyc
.pytest_cache/

# Root dev launcher (package.json at repo root -- concurrently/cross-env only)
/node_modules/

# Frontend
frontend/frontend/node_modules/
frontend/frontend/dist/

# Auth/identity (api/auth/) -- local secrets and the local dev SQLite
# database must never be committed. Real deployments set DATABASE_URL/
# AUTH_SECRET/etc. via the platform's env config, not a checked-in file.
.env
*.db
*.db-journal

# Raw dataset archive (redundant with extracted kolam_data/)
one-stroke-dotted-pulli-kolam.zip

# OS
.DS_Store
Thumbs.db

# M7 platform: local SQLite database + rendered artifact store --
# runtime-generated data, not source (see api/db/database.py's module
# docstring: DATABASE_URL points a real deployment at Postgres instead).
api/db/*.db
api/storage/artifacts/*.svg
api/storage/artifacts/*.png
api/storage/artifacts/*.json
!api/storage/artifacts/.gitkeep
